:8080 {
    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    @authorized {
        path /mcp
        header Authorization "Bearer {$MCP_ACCESS_TOKEN}"
    }
    handle @authorized {
        reverse_proxy mattermost:8000 {
            header_up -Authorization
        }
    }

    handle {
        respond "Unauthorized" 401
    }
}
